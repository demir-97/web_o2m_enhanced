<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_groups_privilege_o2m_enhanced" model="res.groups.privilege">
        <field name="name">Enhanced Tables</field>
        <field name="category_id" ref="base.module_category_extra"/>
    </record>

    <record id="group_o2m_enhanced_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_o2m_enhanced"/>
        <field name="comment">Can enable the enhanced widget on one2many tables and tune its options from the Enhanced Tables setup menu.</field>
    </record>

    <!-- Administrators keep managing the setups out of the box. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_o2m_enhanced_manager'))]"/>
    </record>

</odoo>
