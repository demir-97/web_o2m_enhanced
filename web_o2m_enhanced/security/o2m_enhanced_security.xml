<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_o2m_enhanced" model="ir.module.category">
        <field name="name">Enhanced Tables</field>
        <field name="description">Setup of the enhanced one2many tables.</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_o2m_enhanced_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_o2m_enhanced"/>
        <field name="comment">Can enable the enhanced widget on one2many tables and tune its options from the Enhanced Tables setup menu.</field>
    </record>

    <!-- Administrators keep managing the setups out of the box. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_o2m_enhanced_manager'))]"/>
    </record>

</odoo>
