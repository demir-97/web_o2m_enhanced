<?xml version="1.0" encoding="UTF-8"?>
<!--
     Odoo 20 notes:
     * Owl 3's render context holds only `this` and the template's own
       variables, with no prototype chain back to the component, so every
       component member is addressed explicitly through `this.`. Loop and
       t-set variables (column, record, opt, ftype, isInvisible, ...) stay bare.
     * A template ref is a signal, so t-ref names the ref itself
       (t-ref="this.someRef") rather than a string key.
     * t-model binding a `proxy()` object needs the .proxy modifier.
     * FontAwesome is gone: icons are <i class="oi" data-icon="..."/>, where the
       name is a Material Symbols ligature from the subset Odoo ships.
-->
<templates xml:space="preserve">

    <t t-name="web_o2m_enhanced.EnhancedOne2ManyField" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="attributes">
            <attribute name="t-if">this.props.record.data[this.props.name].count > this.props.record.data[this.props.name].limit or this.showO2mFilterPager</attribute>
        </xpath>
    </t>

    <t t-name="web_o2m_enhanced.EnhancedListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//table[@t-ref='this.tableRef']" position="before">
            <div class="o_o2m_filter_toggle d-flex justify-content-end align-items-center" t-if="this.props.o2mFilter and !this.props.list.isGrouped">
                <button
                    t-if="this.o2mSelectedRecords.length and !this.props.readonly and !this.o2mOptions.disable_bulk_edit"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_bulk_edit_btn btn btn-sm"
                    aria-label="Edit selected lines"
                    title="Edit selected lines"
                    t-on-click="this.onO2mBulkEdit"
                >
                    <i class="oi me-1" data-icon="edit"/><t t-esc="this.o2mSelectedRecords.length"/>
                </button>
                <button
                    t-if="this.o2mSelectedRecords.length and this.o2mCanDuplicate and !this.o2mOptions.disable_duplicate"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_duplicate_btn btn btn-sm"
                    aria-label="Duplicate selected lines"
                    title="Duplicate selected lines"
                    t-on-click="this.onO2mDuplicateSelected"
                >
                    <i class="oi" data-icon="content_copy"/>
                </button>
                <span
                    t-if="this.o2mState.active and !this.o2mState.closing and this.o2mState.truncated"
                    class="o_o2m_filter_truncated"
                    t-att-title="this.o2mTruncatedTitle"
                >
                    <i class="oi" data-icon="warning"/>
                </span>
                <span
                    t-if="this.o2mState.active and !this.o2mState.closing and this.hasActiveFilter"
                    class="o_o2m_filter_count"
                    t-esc="this.o2mCounterText"
                />
                <button
                    t-if="this.o2mState.active and !this.o2mState.closing and this.hasActiveFilter"
                    type="button"
                    class="o_o2m_filter_clear_btn btn btn-sm"
                    aria-label="Clear all filters"
                    title="Clear all filters"
                    t-on-click="this.onClearAllFilters"
                >
                    <i class="oi" data-icon="close"/>
                </button>
                <button
                    t-if="this.props.o2mFilter.hasStoredWidths()"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_reset_widths_btn btn btn-sm"
                    aria-label="Reset column widths"
                    title="Reset column widths"
                    t-on-click="this.onO2mResetWidths"
                >
                    <i class="oi" data-icon="swap_horiz"/>
                </button>
                <button
                    t-if="this.o2mHierarchyFieldName"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_tree_btn btn btn-sm"
                    t-att-class="this.o2mTreeActive ? 'o_active' : ''"
                    t-att-aria-pressed="this.o2mTreeActive ? 'true' : 'false'"
                    aria-label="Hierarchy view"
                    title="Hierarchy view"
                    t-on-click="this.onO2mTreeToggleMode"
                >
                    <i class="oi" data-icon="account_tree"/>
                </button>
                <button
                    t-if="!this.o2mOptions.disable_export"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_export_btn btn btn-sm"
                    aria-label="Export to Excel"
                    title="Export to Excel"
                    t-on-click="this.onO2mExport"
                >
                    <i class="oi" data-icon="download"/>
                </button>
                <button
                    t-if="!this.props.readonly and !this.o2mOptions.disable_import"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_import_btn btn btn-sm"
                    aria-label="Import from Excel or CSV"
                    title="Import from Excel or CSV"
                    t-on-click="this.onO2mImportClick"
                >
                    <i class="oi" data-icon="upload"/>
                </button>
                <input
                    type="file"
                    class="d-none"
                    accept=".xlsx,.csv"
                    t-ref="this.o2mImportInputRef"
                    t-on-change="this.onO2mImportFile"
                />
                <button
                    t-if="!this.props.readonly and !this.o2mOptions.disable_import"
                    type="button"
                    class="o_o2m_filter_toggle_btn o_o2m_paste_btn btn btn-sm"
                    aria-label="Paste from Excel"
                    title="Paste rows copied from Excel"
                    t-on-click="this.onO2mPaste"
                >
                    <i class="oi" data-icon="content_paste"/>
                </button>
                <button
                    t-if="!this.o2mOptions.disable_filter"
                    type="button"
                    class="o_o2m_filter_toggle_btn btn btn-sm"
                    t-att-class="this.o2mState.active and !this.o2mState.closing ? 'o_active' : ''"
                    t-att-aria-pressed="this.o2mState.active ? 'true' : 'false'"
                    aria-label="Toggle column filters"
                    title="Filter"
                    t-on-click="this.onToggleFilter"
                >
                    <i class="oi" data-icon="filter_alt"/>
                </button>
            </div>
        </xpath>
        <xpath expr="//thead/tr" position="after">
            <tr
                t-if="this.props.o2mFilter and this.o2mState.active and !this.props.list.isGrouped"
                class="o_o2m_filter_row"
                t-att-class="this.o2mState.closing ? 'o_closing' : ''"
            >
                <td t-if="this.hasSelectors"/>
                <!-- One cell per header cell, including the column kinds that
                     carry no filter (column_group, buttons, handle): the row
                     lives in the thead and must line up with it. -->
                <t t-foreach="this.columns" t-as="column" t-key="column.id">
                    <td class="o_o2m_filter_cell">
                        <div class="o_o2m_filter_cell_wrap" t-if="column.type === 'field' and column.widget !== 'handle' and !this.isFilterExcluded(column)">
                            <t t-set="ftype" t-value="this.getColumnFilterType(column)"/>
                            <select
                                t-if="ftype === 'boolean'"
                                class="o_o2m_filter_col_input o_o2m_filter_select"
                                t-on-change="(ev) => this.onColFilterInput(column.name, ev)"
                                t-on-keydown="this.onFilterKeydown"
                            >
                                <option value="" t-esc="column.label"/>
                                <t t-foreach="this.getFilterOptions(column)" t-as="opt" t-key="opt[0]">
                                    <option
                                        t-att-value="opt[0]"
                                        t-esc="opt[1]"
                                        t-att-selected="(this.o2mState.cols[column.name] or '') === opt[0]"
                                    />
                                </t>
                            </select>
                            <Dropdown t-elif="ftype === 'select'" position="'bottom-start'" menuClass="'o_o2m_filter_relsel_menu'">
                                <button
                                    type="button"
                                    class="o_o2m_filter_col_input o_o2m_filter_relsel d-flex align-items-center"
                                    t-att-class="(this.o2mState.cols[column.name] or []).length ? '' : 'o_empty'"
                                >
                                    <span class="text-truncate flex-grow-1 text-start" t-esc="this.getSelFilterLabel(column)"/>
                                    <i class="oi o_o2m_filter_caret flex-shrink-0" data-icon="arrow_drop_down"/>
                                </button>
                                <t t-set-slot="content">
                                    <t t-foreach="this.getFilterOptions(column)" t-as="opt" t-key="opt[0]">
                                        <DropdownItem closingMode="'none'" onSelected="() => this.toggleRelFilter(column.name, opt[0])">
                                            <CheckBox
                                                value="this.isRelSelected(column.name, opt[0])"
                                                onChange="() => this.toggleRelFilter(column.name, opt[0])"
                                            >
                                                <span class="text-truncate" t-esc="opt[1]"/>
                                            </CheckBox>
                                        </DropdownItem>
                                    </t>
                                </t>
                            </Dropdown>
                            <div t-elif="ftype === 'date'" class="o_o2m_filter_date_wrap d-flex align-items-center">
                                <input
                                    type="text"
                                    size="1"
                                    class="o_o2m_filter_date_start"
                                    t-att-data-col="column.name"
                                    placeholder="From"
                                />
                                <i class="oi o_o2m_filter_date_arrow" data-icon="arrow_range" role="presentation"/>
                                <input
                                    type="text"
                                    size="1"
                                    class="o_o2m_filter_date_end"
                                    t-att-data-col="column.name"
                                    placeholder="To"
                                />
                                <button
                                    t-if="this.hasDateFilter(column)"
                                    type="button"
                                    class="o_o2m_filter_date_clear btn"
                                    aria-label="Clear date filter"
                                    t-on-click.stop="() => this.onDateFilterClear(column)"
                                >
                                    <i class="oi" data-icon="close_small"/>
                                </button>
                            </div>
                            <Dropdown t-elif="ftype === 'relsel'" position="'bottom-start'" menuClass="'o_o2m_filter_relsel_menu'">
                                <button
                                    type="button"
                                    class="o_o2m_filter_col_input o_o2m_filter_relsel d-flex align-items-center"
                                    t-att-class="(this.o2mState.cols[column.name] or []).length ? '' : 'o_empty'"
                                >
                                    <span class="text-truncate flex-grow-1 text-start" t-esc="this.getRelFilterLabel(column)"/>
                                    <i class="oi o_o2m_filter_caret flex-shrink-0" data-icon="arrow_drop_down"/>
                                </button>
                                <t t-set-slot="content">
                                    <t t-foreach="this.getRelFilterOptions(column)" t-as="opt" t-key="opt.id">
                                        <DropdownItem closingMode="'none'" onSelected="() => this.toggleRelFilter(column.name, opt.id)">
                                            <CheckBox
                                                value="this.isRelSelected(column.name, opt.id)"
                                                onChange="() => this.toggleRelFilter(column.name, opt.id)"
                                            >
                                                <span class="text-truncate" t-esc="opt.label"/>
                                            </CheckBox>
                                        </DropdownItem>
                                    </t>
                                    <div t-if="!this.getRelFilterOptions(column).length" class="text-muted fst-italic px-3 py-2">
                                        No records
                                    </div>
                                </t>
                            </Dropdown>
                            <input
                                t-elif="ftype === 'number'"
                                type="text"
                                size="1"
                                class="o_o2m_filter_col_input text-end"
                                t-att-placeholder="column.label"
                                title="Examples: 0 - 10, 5 -, - 10, &gt;5, &lt;=100"
                                t-att-value="this.o2mState.cols[column.name] or ''"
                                t-on-input="(ev) => this.onColFilterInput(column.name, ev)"
                                t-on-keydown="this.onFilterKeydown"
                            />
                            <input
                                t-else=""
                                type="text"
                                size="1"
                                class="o_o2m_filter_col_input"
                                t-att-placeholder="column.label"
                                t-att-value="this.o2mState.cols[column.name] or ''"
                                t-on-input="(ev) => this.onColFilterInput(column.name, ev)"
                                t-on-keydown="this.onFilterKeydown"
                            />
                        </div>
                    </td>
                </t>
                <td t-if="this.hasOpenFormViewColumn"/>
                <td t-if="this.hasActionsColumn"/>
            </tr>
        </xpath>
    </t>

    <t t-name="web_o2m_enhanced.EnhancedListRenderer.RecordRow" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="primary">
        <!-- In tree mode, the first cell's content (formatter text or edit
             widget — a copy of the core cell body) sits in a flex row next to
             the indent/caret prefix, so editing stays on the same line. -->
        <xpath expr="//td[hasclass('o_data_cell')]/t[@t-if='!isInvisible']" position="replace">
            <t t-if="!isInvisible">
                <div t-if="this.o2mTreeActive and column_index === 0" class="o_o2m_tree_cell_flex">
                    <span
                        class="o_o2m_tree_prefix"
                        t-att-class="this.o2mTreeHasChildren(record) ? 'o_o2m_tree_clickable' : ''"
                        t-att-style="'padding-left: ' + (this.o2mTreeDepth(record) * 1.25) + 'rem'"
                        t-on-click="(ev) => this.onO2mTreePrefixClick(record, ev)"
                    >
                        <i
                            t-if="this.o2mTreeHasChildren(record)"
                            class="oi o_o2m_tree_caret"
                            t-att-data-icon="this.o2mTreeIsCollapsed(record) ? 'chevron_right' : 'expand_more'"
                            role="button"
                            aria-label="Toggle children"
                        />
                        <span t-else="" class="o_o2m_tree_gap"/>
                    </span>
                    <div class="o_o2m_tree_cell_content">
                        <t t-if="this.canUseFormatter(column, record)" t-out="this.getFormattedValue(column, record)"/>
                        <Field t-else="" name="column.name" record="record" type="column.widget" class="this.getFieldClass(column)" fieldInfo="column" t-props="this.getFieldProps(record, column)"/>
                    </div>
                </div>
                <t t-else="">
                    <t t-if="this.canUseFormatter(column, record)" t-out="this.getFormattedValue(column, record)"/>
                    <Field t-else="" name="column.name" record="record" type="column.widget" class="this.getFieldClass(column)" fieldInfo="column" t-props="this.getFieldProps(record, column)"/>
                </t>
            </t>
        </xpath>
    </t>

    <t t-name="web_o2m_enhanced.O2mPasteDialog">
        <Dialog size="'lg'" title="this.title">
            <div t-on-paste="this.onPaste">
                <div
                    t-if="!this.parsedRows.length"
                    class="o_o2m_paste_zone d-flex flex-column align-items-center justify-content-center text-center p-4"
                    tabindex="0"
                    t-ref="this.pasteAreaRef"
                >
                    <i class="oi oi-2x mb-2" data-icon="content_paste" role="presentation"/>
                    <span>Copy cells in Excel, then press <b>Ctrl+V</b> here</span>
                    <span class="form-text">Include the header row to update existing lines by ID.</span>
                </div>
                <t t-else="">
                    <div class="o_o2m_paste_preview table-responsive border rounded">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th t-foreach="this.previewHeaders" t-as="header" t-key="header_index" t-esc="header"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="this.previewRows" t-as="row" t-key="row_index">
                                    <td t-foreach="row" t-as="cell" t-key="cell_index" t-esc="cell"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text" t-if="this.previewMoreCount">
                        + <t t-esc="this.previewMoreCount"/> more row(s)
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <div class="form-check">
                            <input
                                type="checkbox"
                                class="form-check-input"
                                id="o2m_paste_headers"
                                t-att-checked="this.hasHeaders"
                                t-on-change="this.onHeadersToggle"
                            />
                            <label class="form-check-label" for="o2m_paste_headers">
                                First row contains column headers
                            </label>
                        </div>
                        <button type="button" class="btn btn-sm btn-link" t-on-click="this.clearPaste">
                            Paste something else
                        </button>
                    </div>
                    <div class="form-text" t-esc="this.previewText"/>
                </t>
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary"
                    t-att-disabled="!this.dataRows.length or undefined"
                    t-on-click="this.onConfirm"
                >Import</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web_o2m_enhanced.O2mBulkEditDialog">
        <Dialog size="'md'" title="this.title">
            <p class="text-muted" t-esc="this.subtitle"/>
            <div class="mb-3">
                <label class="form-label" for="o2m_bulk_edit_field">Field</label>
                <select id="o2m_bulk_edit_field" class="form-select" t-on-change="this.onFieldChange">
                    <t t-foreach="this.props.fields" t-as="f" t-key="f.name">
                        <option
                            t-att-value="f.name"
                            t-esc="f.label"
                            t-att-selected="f.name === this.state.fieldName"
                        />
                    </t>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label" for="o2m_bulk_edit_value">Value</label>
                <select
                    t-if="this.selectedField and this.selectedField.type === 'selection'"
                    id="o2m_bulk_edit_value"
                    class="form-select"
                    t-model.proxy="this.state.text"
                >
                    <option value=""/>
                    <t t-foreach="this.selectedField.selection" t-as="opt" t-key="opt[0]">
                        <option t-att-value="opt[0]" t-esc="opt[1]"/>
                    </t>
                </select>
                <select
                    t-elif="this.selectedField and this.selectedField.type === 'boolean'"
                    id="o2m_bulk_edit_value"
                    class="form-select"
                    t-model.proxy="this.state.boolChoice"
                >
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
                <div t-elif="this.selectedField and this.selectedField.type === 'many2many'">
                    <div t-if="this.state.tags.length" class="d-flex flex-wrap gap-1 mb-2">
                        <span
                            t-foreach="this.state.tags"
                            t-as="tag"
                            t-key="tag.id"
                            class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center"
                        >
                            <t t-esc="tag.display_name"/>
                            <i
                                class="oi ms-1"
                                data-icon="close_small"
                                role="button"
                                aria-label="Remove tag"
                                t-on-click="() => this.removeTag(tag.id)"
                            />
                        </span>
                    </div>
                    <input
                        id="o2m_bulk_edit_value"
                        type="text"
                        class="form-control"
                        list="o2m_bulk_edit_tag_options"
                        placeholder="Type to search, pick to add..."
                        t-model.proxy="this.state.tagSearch"
                        t-on-input="this.onTagInput"
                    />
                    <datalist id="o2m_bulk_edit_tag_options">
                        <option
                            t-foreach="this.state.tagOptions"
                            t-as="opt"
                            t-key="opt.id"
                            t-att-value="opt.display_name"
                        />
                    </datalist>
                    <div class="form-text">
                        The selected tags replace the current values on the selected lines; empty clears them.
                    </div>
                </div>
                <div t-elif="this.selectedField and this.selectedField.type === 'many2one'">
                    <input
                        id="o2m_bulk_edit_value"
                        type="text"
                        class="form-control"
                        list="o2m_bulk_edit_m2o_options"
                        placeholder="Type to search, pick a record..."
                        t-model.proxy="this.state.m2oSearch"
                        t-on-input="this.onM2oInput"
                        t-on-keydown="this.onKeydown"
                    />
                    <datalist id="o2m_bulk_edit_m2o_options">
                        <option
                            t-foreach="this.state.m2oOptions"
                            t-as="opt"
                            t-key="opt.id"
                            t-att-value="opt.display_name"
                        />
                    </datalist>
                    <div class="form-text text-success" t-if="this.state.m2o">
                        <i class="oi me-1" data-icon="check" role="presentation"/><t t-esc="this.state.m2o.display_name"/>
                    </div>
                </div>
                <input
                    t-else=""
                    id="o2m_bulk_edit_value"
                    t-att-type="this.inputType"
                    class="form-control"
                    t-model.proxy="this.state.text"
                    t-on-keydown="this.onKeydown"
                />
                <div
                    t-if="!this.selectedField or (this.selectedField.type !== 'boolean' and this.selectedField.type !== 'many2many')"
                    class="form-text"
                >
                    Leave empty to clear the field on the selected lines.
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onConfirm">Apply</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web_o2m_enhanced.O2mDuplicateDialog">
        <Dialog size="'sm'" title="this.title">
            <div class="o_o2m_duplicate_body">
                <p class="text-muted" t-esc="this.subtitle"/>
                <label class="form-label" for="o2m_duplicate_count">Number of copies per line</label>
                <input
                    id="o2m_duplicate_count"
                    type="number"
                    class="form-control"
                    min="1"
                    t-att-max="this.maxCopies"
                    t-model.proxy.number="this.state.count"
                    t-on-keydown="this.onKeydown"
                />
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onConfirm">Duplicate</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web_o2m_enhanced.EnhancedListRenderer.Rows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary">
        <xpath expr="//t[@t-foreach='list.records']" position="after">
            <tr t-if="this.hasActiveFilter and !this.filteredRecords.length" class="o_o2m_filter_no_results">
                <td t-att-colspan="this.nbCols" class="text-muted fst-italic p-2">
                    No matching records
                </td>
            </tr>
        </xpath>
        <xpath expr="//t[@t-foreach='list.records']" position="attributes">
            <attribute name="t-foreach">this.filteredRecords</attribute>
        </xpath>
    </t>

</templates>
